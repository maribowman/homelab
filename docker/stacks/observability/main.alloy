// DOCKER CONTAINER DISCOVERY

discovery.docker "docker_container" {
    host = "unix:///var/run/docker.sock"
}

// OBSERVABILITY METRICS

import.file "observability" {
    filename = "/etc/alloy/modules/observability.alloy"
}

observability.scrape_metrics "observability_metrics" {
    targets = [
        { "__address__" = "node-exporter:9100", "instance" = "node-exporter" },
        { "__address__" = "prometheus:9090", "instance" = "prometheus" },
        { "__address__" = "loki:3100", "instance" = "loki" },
        { "__address__" = "grafana:3000", "instance" = "grafana" },
    ]
    forward_to = [prometheus.remote_write.local_prometheus.receiver]
}

// SYNOLOGY METRICS

import.file "generic" {
    filename = "/etc/alloy/modules/generic.alloy"
}

generic.scrape_metrics "synology_metrics" {
    targets = [{ "__address__" = "192.168.0.3:9100" }]
    forward_to = [prometheus.remote_write.local_prometheus.receiver]
    job_label = "synology-monitoring"
}

// DOCKER CONTAINER METRICS

// Logporter exports per-container metrics for every container on the host
// (not just the observability stack), so it gets its own job label.
generic.scrape_metrics "docker_container_metrics" {
    targets = [{ "__address__" = "logporter:9333", "instance" = "logporter" }]
    forward_to = [prometheus.remote_write.local_prometheus.receiver]
    job_label = "docker-containers"
}

prometheus.remote_write "local_prometheus" {
    endpoint {
        url = "http://prometheus:9090/api/v1/write"
    }
}

// LOGS

discovery.relabel "docker_container_relabel" {
    targets = discovery.docker.docker_container.targets

    rule {
        source_labels = ["__meta_docker_container_name"]
        regex         = "/(.*)"
        target_label  = "service_name"
    }

    rule {
        source_labels = ["__meta_docker_container_name"]
        regex         = "/(.*)"
        target_label  = "container_name"
    }
}

// TODO: It looks like Dockge logs are rejected because the container runs with timezone UTC

loki.source.docker "docker_container_logs" {
    host    = "unix:///var/run/docker.sock"
    targets = discovery.relabel.docker_container_relabel.output
    forward_to = [loki.write.local_loki.receiver]
}

local.file_match "system_logs" {
    path_targets = [{ "__path__" = "/var/log/*.log", "job" = "systemlogs" }]
}

loki.source.file "local_files" {
    targets = local.file_match.system_logs.targets
    forward_to = [loki.write.local_loki.receiver]
}

loki.write "local_loki" {
    endpoint {
        url = "http://loki:3100/loki/api/v1/push"
    }
}
