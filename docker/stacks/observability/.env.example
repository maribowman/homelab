# Copy to .env and set a strong value. The .env file is gitignored and must be
# provisioned on the DockerVM (it is rsynced from here on deploy if present locally).
#
# Grafana admin password. Without it the admin account defaults to admin/admin.
# Anonymous Viewer access stays enabled; this only protects the admin account.
GF_SECURITY_ADMIN_PASSWORD=change-me
