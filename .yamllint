---
extends: default

# gitignore-style patterns
ignore: |
  .git/
  .claude/
  ansible/.venv/
  docker/stacks/*/data/
  **/.venv/

rules:
  # Compose files and Taskfiles don't use document start markers
  document-start: disable
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false # GitHub Actions' `on:` key
  # Settings required for ansible-lint compatibility
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
